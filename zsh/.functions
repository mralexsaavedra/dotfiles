# mkcd: Create a directory and enter it
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# clone: Clone git repository and enter it
# Usage: clone author/repo (assumes github.com) OR clone https://...
clone() {
    local repo="$1"

    if [[ -z "$repo" ]]; then
        echo "Usage: clone <author/repo|url|git@...>"
        return 1
    fi

    if [[ "$repo" != *"://"* ]] && [[ "$repo" != git@* ]]; then
        repo="https://github.com/$repo"
    fi

    git clone "$repo" || return

    local repo_dir="${repo##*/}"
    repo_dir="${repo_dir%.git}"
    cd "$repo_dir" || return
}

# extract: Extract any compressed file
extract() {
    [[ -f "$1" ]] || { echo "'$1' is not a valid file"; return 1; }
    # macOS tar (bsdtar/libarchive) reads zip, rar, 7z and iso natively
    case "$1" in
      *.tar.*|*.tgz|*.tbz2|*.tar|*.zip|*.rar|*.7z|*.iso) tar xf "$1" ;;
      *.gz)  gunzip "$1"     ;;
      *.bz2) bunzip2 "$1"    ;;
      *.xz)  unxz "$1"       ;;
      *.Z)   uncompress "$1" ;;
      *)     echo "'$1' cannot be extracted via extract()" ;;
    esac
}

# tre: Tree with gitignore respect (uses eza if available)
tre() {
  if command -v eza &> /dev/null; then
    eza --tree --level=${1:-2} --icons --ignore-glob=".git|node_modules"
  else
    tree -I 'node_modules|.git|dist|build' --dirsfirst -L ${1:-2} -C
  fi
}

# Git worktrees under <repo-parent>/<repo>-worktrees/<name>
#   wt                 list worktrees of the current repo
#   wt <name> [base]   cd into worktree <name>, creating it (and the branch) if needed
#   wt rm <name>       remove worktree <name> (git refuses if it has changes)
wt() {
    local common root repo dir
    common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || {
        echo "wt: not inside a git repository"
        return 1
    }
    root="${common%/.git}"
    repo="${root##*/}"
    dir="${root%/*}/${repo}-worktrees"

    if [[ -z "$1" ]]; then
        git -C "$root" worktree list
        return
    fi

    if [[ "$1" == "rm" ]]; then
        [[ -z "$2" ]] && { echo "Usage: wt rm <name>"; return 1; }
        git -C "$root" worktree remove "$dir/$2" && echo "Removed $dir/$2"
        return
    fi

    local name="$1" base="$2"
    if [[ ! -d "$dir/$name" ]]; then
        git -C "$root" fetch --quiet origin || return
        if git -C "$root" show-ref --quiet "refs/heads/$name"; then
            git -C "$root" worktree add "$dir/$name" "$name" || return
        elif git -C "$root" show-ref --quiet "refs/remotes/origin/$name"; then
            git -C "$root" worktree add --track -b "$name" "$dir/$name" "origin/$name" || return
        else
            [[ -z "$base" ]] && base=$(git -C "$root" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)
            git -C "$root" worktree add --no-track -b "$name" "$dir/$name" "${base:-origin/main}" || return
        fi
    fi
    cd "$dir/$name" || return
}
