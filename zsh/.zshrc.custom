# =============================================================================
# User customizations (tracked)
# =============================================================================

# Shared aliases/functions no longer guaranteed by upstream base.
[[ -f "$HOME/.aliases" ]] && source "$HOME/.aliases"
[[ -f "$HOME/.functions" ]] && source "$HOME/.functions"

# Personal project root used by custom scripts/workflows.
export PROJECT_PATHS="/home/alanbuscaglia/work"

# Personal FZF defaults.
export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
export FZF_DEFAULT_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"

# Node version auto-switch (custom behavior).
if command -v fnm >/dev/null 2>&1; then
  eval "$(fnm env --use-on-cd --shell zsh)"
fi

# Personal fzf helpers.
alias fzfbat='fzf --preview="bat --theme=gruvbox-dark --color=always {}"'
alias fzfnvim='nvim "$(fzf --preview="bat --theme=gruvbox-dark --color=always {}")"'

# Terminal multiplexer auto-start hook.
# Override WM_CMD in ~/.zshrc.local if you prefer zellij.
# WM_CMD="${WM_CMD:-tmux}"

start_if_needed() {
  [[ $- != *i* ]] && return
  [[ -n "$TMUX" || -n "$ZELLIJ" ]] && return
  [[ ! -t 1 ]] && return

  if command -v "$WM_CMD" >/dev/null 2>&1; then
    exec "$WM_CMD"
  fi
}

# start_if_needed

# Rex: plain prompt matching Rex's terminal preview ("~/rex  main $"),
# instead of Powerlevel10k. Other terminals keep p10k.
if [[ "$TERM_PROGRAM" == "rex" ]]; then
  (( $+functions[powerlevel10k_plugin_unload] )) && powerlevel10k_plugin_unload
  autoload -Uz vcs_info add-zsh-hook
  zstyle ':vcs_info:*' enable git
  zstyle ':vcs_info:git:*' formats $' \ue0a0 %b'
  zstyle ':vcs_info:git:*' actionformats $' \ue0a0 %b|%a'
  add-zsh-hook precmd vcs_info
  setopt prompt_subst
  PROMPT='%~${vcs_info_msg_0_} $ '
  RPROMPT=''
  # Use Rex's theme palette: drop hardcoded 256-color overrides so tools emit ANSI colors.
  unset LS_COLORS LSCOLORS
  export BAT_THEME=ansi
  alias fzfbat='fzf --preview="bat --color=always {}"'
  alias fzfnvim='nvim "$(fzf --preview="bat --color=always {}")"'
fi
