# Linux Brewfile (homelab `dev` LXC). CLI tools only: no casks, nothing macOS-specific.
# Installed into the shared Homebrew prefix /home/linuxbrew/.linuxbrew by `./setup.sh --machine`.
# Keep it in step with brew/Brewfile when a CLI tool is added there.
tap "gentleman-programming/tap", "https://github.com/Gentleman-Programming/homebrew-tap", trusted: true
tap "multica-ai/tap"
brew "atuin"
brew "bash"
brew "bat"
brew "btop"
brew "carapace"
brew "curl"
brew "eza"
brew "fd"
brew "fnm"
brew "fzf"
brew "gcc"
brew "gh"
brew "git"
brew "git-delta"
brew "git-lfs"
brew "htop"
brew "httpie"
brew "jq"
brew "lazygit"
brew "neovim"
# Node for global CLI tools (codegraph below); projects use fnm
brew "node"
brew "powerlevel10k"
brew "ripgrep"
brew "rtk"
brew "sd"
brew "shellcheck"
brew "sqlite"
brew "stow"
# tlrc: official tldr client, bottled on Linux (the tldr formula builds from source and fails there)
brew "tlrc"
brew "tmux"
brew "tree"
brew "tree-sitter-cli"
brew "uv"
brew "yt-dlp"
brew "zellij"
brew "zoxide"
brew "zsh-autocomplete"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "gentleman-programming/tap/engram"
brew "gentleman-programming/tap/gentle-ai"
brew "gentleman-programming/tap/gga"
# Multica CLI + agent daemon (homelab dev runtime)
brew "multica-ai/tap/multica"
npm "@colbymchenry/codegraph"
# Node 25+ no longer ships corepack; projects pin pnpm/yarn through packageManager
npm "corepack"
